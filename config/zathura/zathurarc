# Zathura — tez va yengil PDF ko'ruvchi (VimTeX bilan SyncTeX ishlaydi)
include colors

set selection-clipboard clipboard
set adjust-open best-fit
set pages-per-row 1
set scroll-page-aware true
set scroll-step 80
set smooth-scroll true
set zoom-min 10
set guioptions ""
set font "Inter 11"
set window-title-basename true
set statusbar-home-tilde true
set synctex true
set recolor false
set recolor-keephue true
set database sqlite

map <C-r> recolor
map r reload
map D toggle_page_mode
map i recolor
map <C-=> zoom in
map <C--> zoom out

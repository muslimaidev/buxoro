{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/buxoro.txt",
    "color": { "1": "bright_yellow", "2": "cyan", "3": "blue", "4": "bright_black" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "yellow" },
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[90m─────────────────────────────" },
    { "type": "os",       "key": "󰣇 Tizim" },
    { "type": "kernel",   "key": " Yadro" },
    { "type": "wm",       "key": " Muhit" },
    { "type": "shell",    "key": " Shell" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "packages", "key": "󰏖 Paketlar" },
    { "type": "cpu",      "key": " Protsessor" },
    { "type": "gpu",      "key": "󰢮 Video" },
    { "type": "memory",   "key": " Xotira" },
    { "type": "disk",     "key": "󰋊 Disk", "folders": "/" },
    { "type": "battery",  "key": "󰁹 Batareya" },
    { "type": "uptime",   "key": " Ishlamoqda" },
    "break",
    "colors"
  ]
}

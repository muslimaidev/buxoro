#!/usr/bin/env bash
# bx-boot — tez va chiroyli yuklanish
#
#   bx-boot status    bootloader, splash, yuklanish vaqti
#   bx-boot theme     bootloader mavzusi (GRUB / Limine) yoki tezkor menyu (systemd-boot)
#   bx-boot splash    Plymouth "Buxoro" splash ekrani + jim yuklanish
#   bx-boot speed     yuklanishni sekinlashtiradigan xizmatlarni o'chirish
#   bx-boot all       hammasi
#
# Har bir o'zgartirilgan fayl <fayl>.bx-backup-<sana> nomi bilan zaxiralanadi.
set -euo pipefail

BX_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
STAMP="$(date +%Y%m%d-%H%M%S)"
PARAMS=(quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=auto vt.global_cursor_default=0)

c_acc=$'\e[1;36m' c_ok=$'\e[1;32m' c_warn=$'\e[1;33m' c_off=$'\e[0m'
step() { printf '\n%s::%s %s\n' "$c_acc" "$c_off" "$*"; }
ok()   { printf '   %s✓%s %s\n' "$c_ok" "$c_off" "$*"; }
warn() { printf '   %s!%s %s\n' "$c_warn" "$c_off" "$*"; }
backup() { [[ -f $1 ]] && sudo cp -a "$1" "$1.bx-backup-$STAMP" && ok "zaxira: $1.bx-backup-$STAMP"; }

esp_path() {
    local p
    # /boot ko'pincha faqat root o'qiydigan qilib ulanadi (archinstall: fmask=0077) — sudo bilan
    p=$(sudo bootctl -p 2>/dev/null || true)
    [[ -n $p ]] && { echo "$p"; return; }
    for p in /efi /boot /boot/efi; do sudo test -d "$p/EFI" && { echo "$p"; return; }; done
    return 0
}

limine_conf() {
    local esp; esp=$(esp_path)
    local c
    for c in /boot/limine.conf /boot/limine/limine.conf "$esp/limine.conf" "$esp/EFI/limine/limine.conf" \
             "$esp/EFI/BOOT/limine.conf" /boot/EFI/limine/limine.conf /efi/EFI/limine/limine.conf; do
        [[ -n $c ]] && sudo test -f "$c" && { echo "$c"; return; }
    done
    return 0
}

# UEFI o'zgaruvchisi: hozirgi tizimni qaysi bootloader yuklagani (systemd-boot, Limine,
# rEFInd va GRUB 2.12+ "bli" moduli yozadi). Faylni oddiy foydalanuvchi ham o'qiy oladi.
loader_info() {
    local v=/sys/firmware/efi/efivars/LoaderInfo-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
    [[ -r $v ]] && tail -c +5 "$v" | tr -d '\0'
    return 0
}

refind_conf() {
    local esp; esp=$(esp_path)
    local c
    for c in "$esp/EFI/refind/refind.conf" "$esp/EFI/BOOT/refind.conf" /boot/EFI/refind/refind.conf; do
        sudo test -f "$c" 2>/dev/null && { echo "$c"; return; }
    done
    return 0
}

detect() {
    local li; li=$(loader_info)
    case "$li" in
        *systemd-boot*) echo systemd-boot; return ;;
        *[Ll]imine*)    echo limine; return ;;
        *rEFInd*)       echo refind; return ;;
        *GRUB*)         echo grub; return ;;
    esac
    local esp; esp=$(esp_path)
    if [[ -n "$(limine_conf)" ]]; then echo limine
    elif [[ -f /etc/default/grub ]] && { sudo test -d /boot/grub || sudo test -d "$esp/grub"; }; then echo grub
    elif sudo bootctl is-installed >/dev/null 2>&1; then echo systemd-boot
    elif [[ -n "$(refind_conf)" ]]; then echo refind
    else echo unknown
    fi
}

# Aniqlanmasa — foydalanuvchi yuborishi uchun tashxis ma'lumoti
diagnose() {
    echo
    echo "   Tashxis (shuni yuboring):"
    echo "   ── LoaderInfo: $(li=$(loader_info); echo "${li:-yo‘q}")"
    echo "   ── ESP: $(e=$(esp_path); echo "${e:-topilmadi}")"
    echo "   ── /etc/default/grub: $([[ -f /etc/default/grub ]] && echo bor || echo "yo‘q")"
    echo "   ── bootctl:"; sudo bootctl status 2>&1 | sed -n '1,12p' | sed 's/^/        /'
    echo "   ── EFI papkalari:"; sudo find "$(esp_path)/EFI" -maxdepth 2 -iname '*.efi' 2>/dev/null | head -12 | sed 's/^/        /'
    echo "   ── efibootmgr:"; sudo efibootmgr 2>/dev/null | head -8 | sed 's/^/        /'
    echo "   ── /etc/kernel/cmdline: $([[ -f /etc/kernel/cmdline ]] && echo "bor (UKI)" || echo "yo‘q")"
}

# ── Yadro parametrlarini qo'shish (takrorlanmasdan) ──────────────────
add_params() {
    local bl=$1 p
    case "$bl" in
        grub)
            backup /etc/default/grub
            for p in "${PARAMS[@]}"; do
                sudo grep -qE "^GRUB_CMDLINE_LINUX_DEFAULT=.*(^|[\" ])${p}([\" ]|$)" /etc/default/grub ||
                    sudo sed -i -E "s/^(GRUB_CMDLINE_LINUX_DEFAULT=\"[^\"]*)\"/\1 ${p}\"/" /etc/default/grub
            done
            sudo sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=")\s+/\1/' /etc/default/grub
            ok "GRUB: $(grep ^GRUB_CMDLINE_LINUX_DEFAULT /etc/default/grub)" ;;
        systemd-boot|limine)
            local files=()
            [[ -f /etc/kernel/cmdline ]] && files+=(/etc/kernel/cmdline)
            if [[ $bl == systemd-boot ]]; then
                local esp; esp=$(esp_path)
                while IFS= read -r f; do files+=("$f"); done < <(sudo find "$esp/loader/entries" -name '*.conf' 2>/dev/null)
            else
                files+=("$(limine_conf)")
            fi
            local f
            for f in "${files[@]}"; do
                backup "$f"
                for p in "${PARAMS[@]}"; do
                    if [[ $f == /etc/kernel/cmdline ]]; then
                        sudo grep -qE "(^| )${p}( |$)" "$f" || sudo sed -i -E "1 s/\$/ ${p}/" "$f"
                    elif [[ $bl == systemd-boot ]]; then
                        sudo sed -i -E "/^options /{/(^| )${p}( |$)/! s/\$/ ${p}/}" "$f"
                    else
                        sudo sed -i -E "/^\s*(kernel_)?cmdline:/{/(:| )${p}( |$)/! s/\$/ ${p}/}" "$f"
                    fi
                done
                ok "parametrlar qo'shildi: $f"
            done
            if [[ $bl == limine && -f /etc/default/limine ]]; then
                warn "/etc/default/limine topildi (limine-mkinitcpio-hook). KERNEL_CMDLINE ga ham qo'shing: ${PARAMS[*]}"
            fi
            if [[ -f /etc/kernel/cmdline ]]; then sudo mkinitcpio -P >/dev/null && ok "UKI qayta yaratildi"; fi ;;
        refind)
            local rl
            for rl in /boot/refind_linux.conf "$(esp_path)/refind_linux.conf"; do
                sudo test -f "$rl" || continue
                backup "$rl"
                for p in "${PARAMS[@]}"; do
                    # Har bir qatordagi ikkinchi qo'shtirnoq ichidagi parametrlar
                    sudo sed -i -E "/^\s*\"[^\"]*\"\s+\"/{/(\"| )${p}(\"| )/! s/^(\s*\"[^\"]*\"\s+\"[^\"]*)\"/\1 ${p}\"/}" "$rl"
                done
                ok "parametrlar qo'shildi: $rl"
            done
            if [[ -f /etc/kernel/cmdline ]]; then
                for p in "${PARAMS[@]}"; do sudo grep -qE "(^| )${p}( |$)" /etc/kernel/cmdline || sudo sed -i -E "1 s/\$/ ${p}/" /etc/kernel/cmdline; done
                sudo mkinitcpio -P >/dev/null && ok "UKI qayta yaratildi"
            fi ;;
        *)
            if [[ -f /etc/kernel/cmdline ]]; then
                # Bootloadersiz UKI (to'g'ridan-to'g'ri UEFI orqali) — parametrlar UKI ichida
                backup /etc/kernel/cmdline
                for p in "${PARAMS[@]}"; do sudo grep -qE "(^| )${p}( |$)" /etc/kernel/cmdline || sudo sed -i -E "1 s/\$/ ${p}/" /etc/kernel/cmdline; done
                sudo mkinitcpio -P >/dev/null && ok "UKI: parametrlar qo'shildi va qayta yaratildi"
            else
                warn "Bootloader aniqlanmadi — yadro parametrlarini qo'lda qo'shing: ${PARAMS[*]}"
            fi ;;
    esac
    if [[ $bl == grub ]]; then sudo grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 && ok "grub.cfg yangilandi"; fi
}

# ── GRUB shriftlari: tizimdagi TTF dan .pf2 yaratish va ichki nomini o'qish ──
pf2() { # pf2 <fc-pattern> <o'lcham> <chiqish>
    local file; file=$(fc-match -f '%{file}' "$1")
    sudo grub-mkfont -s "$2" -o "$3" "$file" >/dev/null 2>&1
    # PF2 sarlavhasi: "FILE" uzunlik "PFF2" "NAME" <4 bayt uzunlik> <nom\0> — nom 20-baytdan boshlanadi
    local b len
    read -r -a b < <(sudo od -An -tu1 -j16 -N4 "$3")
    len=$(( (b[0] << 24) + (b[1] << 16) + (b[2] << 8) + b[3] - 1 ))
    sudo dd if="$3" bs=1 skip=20 count="$len" status=none
}

theme_grub() {
    local dir=/boot/grub/themes/buxoro
    sudo mkdir -p "$dir"
    sudo install -m644 -t "$dir" "$BX_DIR"/boot/grub/{background.png,select_c.png,select_e.png,select_w.png}
    local reg small title mono
    reg=$(pf2 "Inter:style=Regular" 20 "$dir/inter-20.pf2")
    small=$(pf2 "Inter:style=Regular" 15 "$dir/inter-15.pf2")
    title=$(pf2 "Inter Display:style=SemiBold" 34 "$dir/inter-title-34.pf2")
    mono=$(pf2 "JetBrainsMono Nerd Font:style=Regular" 16 "$dir/mono-16.pf2")
    sed -e "s|@FONT_REG@|$reg|; s|@FONT_SMALL@|$small|; s|@FONT_TITLE@|$title|; s|@FONT_MONO@|$mono|" \
        "$BX_DIR/boot/grub/theme.txt.in" | sudo tee "$dir/theme.txt" >/dev/null
    ok "Mavzu: $dir (shriftlar: $reg / $small / $title)"

    backup /etc/default/grub
    local kv
    for kv in 'GRUB_THEME="/boot/grub/themes/buxoro/theme.txt"' 'GRUB_TIMEOUT=2' 'GRUB_TIMEOUT_STYLE=menu' \
              'GRUB_GFXMODE=auto' 'GRUB_GFXPAYLOAD_LINUX=keep' 'GRUB_TERMINAL_OUTPUT=gfxterm'; do
        local key=${kv%%=*}
        if sudo grep -qE "^#?\s*${key}=" /etc/default/grub; then
            sudo sed -i -E "s|^#?\s*${key}=.*|${kv}|" /etc/default/grub
        else
            echo "$kv" | sudo tee -a /etc/default/grub >/dev/null
        fi
    done
    sudo grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 && ok "grub.cfg yangilandi (2 soniyalik chiroyli menyu)"
}

theme_limine() {
    local conf; conf=$(limine_conf)
    local dir; dir=$(dirname "$conf")
    backup "$conf"
    sudo install -m644 "$BX_DIR/boot/grub/background.png" "$dir/buxoro-boot.png"
    local keys="timeout|interface_branding|interface_branding_colour|interface_branding_color|interface_help_hidden|wallpaper|wallpaper_style|term_background|term_foreground|term_background_bright|term_foreground_bright|term_palette|term_palette_bright|term_margin|term_margin_gradient"
    local tmp; tmp=$(mktemp)
    # Eski Buxoro blokini va takrorlanadigan global sozlamalarni olib tashlab, yangisini boshiga qo'yamiz
    sudo cat "$conf" | awk -v keys="^\\\\s*($keys)\\\\s*:" '
        /^# ── Buxoro: Limine/ {skip=1}
        skip && /^# ── Buxoro tugadi/ {skip=0; next}
        skip {next}
        /^\s*\// {entries=1}
        !entries && tolower($0) ~ keys {next}
        {print}' > "$tmp.body"
    # wallpaper yo'li limine.conf joylashgan bo'limga nisbatan: boot():/<nisbiy yo'l>
    local mnt rel
    mnt=$(findmnt -no TARGET -T "$dir" 2>/dev/null || echo "$dir")
    rel="${dir#"$mnt"}"
    sed "s|boot():/buxoro-boot.png|boot():${rel}/buxoro-boot.png|" "$BX_DIR/boot/grub/limine-theme.conf" > "$tmp"
    cat "$tmp" "$tmp.body" | sudo tee "$conf" >/dev/null
    rm -f "$tmp" "$tmp.body"
    ok "Limine mavzusi: $conf"
}

theme_refind() {
    local conf; conf=$(refind_conf)
    local dir; dir=$(dirname "$conf")
    backup "$conf"
    sudo install -m644 "$BX_DIR/boot/grub/background.png" "$dir/buxoro-banner.png"
    local kv key
    for kv in "timeout 2" "banner buxoro-banner.png" "banner_scale fillscreen" "hideui hints,arrows,badges" \
              "selection_big buxoro-sel.png" "selection_small buxoro-sel.png" "showtools shutdown,reboot,firmware"; do
        key=${kv%% *}
        if sudo grep -qE "^\s*#?\s*${key}\b" "$conf"; then
            sudo sed -i -E "0,/^\s*#?\s*${key}\b.*/s//${kv}/" "$conf"
        else
            echo "$kv" | sudo tee -a "$conf" >/dev/null
        fi
    done
    sudo install -m644 "$BX_DIR/boot/grub/select_c.png" "$dir/buxoro-sel.png"
    ok "rEFInd mavzusi: $conf (fon, 2 soniya, ortiqcha yozuvlarsiz)"
}

theme_systemd_boot() {
    local esp; esp=$(esp_path)
    local lc="$esp/loader/loader.conf"
    backup "$lc"
    if sudo grep -qE '^\s*timeout' "$lc" 2>/dev/null; then
        sudo sed -i -E 's/^\s*timeout.*/timeout 0/' "$lc"
    else
        echo "timeout 0" | sudo tee -a "$lc" >/dev/null
    fi
    ok "systemd-boot: menyu yashirin (timeout 0). Menyuni ko'rish uchun yoqishda Probel tugmasini bosib turing."
    warn "systemd-boot mavzu qo'llamaydi; go'zallik Plymouth splash orqali beriladi (bx-boot splash)."
}

cmd_theme() {
    local bl; bl=$(detect)
    step "Bootloader: $bl"
    case "$bl" in
        grub)         theme_grub ;;
        limine)       theme_limine ;;
        systemd-boot) theme_systemd_boot ;;
        refind)       theme_refind ;;
        *)            warn "Bootloader aniqlanmadi — hech narsa o'zgartirilmadi (kompyuter avvalgidek yuklanadi)."
                      diagnose; return 1 ;;
    esac
}

cmd_splash() {
    step "Plymouth: Buxoro splash"
    sudo pacman -S --needed --noconfirm plymouth >/dev/null && ok "plymouth o'rnatilgan"
    sudo mkdir -p /usr/share/plymouth/themes/buxoro
    sudo install -m644 -t /usr/share/plymouth/themes/buxoro "$BX_DIR"/boot/plymouth/buxoro/*
    ok "Mavzu nusxalandi"

    local mk=/etc/mkinitcpio.conf
    if ! grep -qE '^HOOKS=.*\bplymouth\b' "$mk"; then
        backup "$mk"
        if grep -qE '^HOOKS=.*\bsystemd\b' "$mk"; then
            sudo sed -i -E '/^HOOKS=/ s/\bsystemd\b/systemd plymouth/' "$mk"
        else
            sudo sed -i -E '/^HOOKS=/ s/\budev\b/udev plymouth/' "$mk"
        fi
        ok "mkinitcpio: $(grep ^HOOKS= "$mk")"
    fi
    sudo plymouth-set-default-theme buxoro
    sudo mkinitcpio -P >/dev/null 2>&1 && ok "initramfs qayta yaratildi"
    add_params "$(detect)"
}

cmd_speed() {
    step "Yuklanish tezligi"
    # Tarmoq ulanishini kutish yuklanishni 5–30 soniya sekinlashtiradi; ish stoli uchun kerak emas
    if systemctl is-enabled NetworkManager-wait-online.service >/dev/null 2>&1; then
        sudo systemctl disable NetworkManager-wait-online.service >/dev/null 2>&1 && ok "NetworkManager-wait-online o'chirildi"
    else
        ok "NetworkManager-wait-online allaqachon o'chirilgan"
    fi
    # Jurnalni cheklash (katta jurnal yuklanishda sekin o'qiladi)
    sudo mkdir -p /etc/systemd/journald.conf.d
    printf '[Journal]\nSystemMaxUse=200M\n' | sudo tee /etc/systemd/journald.conf.d/10-buxoro.conf >/dev/null
    ok "journald: 200 MB chegarasi"
    # Ishlatilmaganda fstrim (SSD uchun haftalik)
    sudo systemctl enable fstrim.timer >/dev/null 2>&1 && ok "fstrim.timer (SSD) yoqildi"
}

cmd_status() {
    step "Holat"
    echo "   Bootloader:  $(detect)   (UEFI LoaderInfo: $(li=$(loader_info); echo "${li:-yo‘q}"))"
    echo "   Splash:      $(plymouth-set-default-theme 2>/dev/null || echo "o'rnatilmagan")"
    echo "   Yadro:       $(cat /proc/cmdline)"
    if command -v systemd-analyze >/dev/null; then
        echo; systemd-analyze 2>/dev/null | head -2 | sed 's/^/   /'
        echo; echo "   Eng sekin 5 ta xizmat:"
        systemd-analyze blame 2>/dev/null | head -5 | sed 's/^/     /'
    fi
}

case "${1:-status}" in
    status) cmd_status ;;
    theme)  cmd_theme ;;
    splash) cmd_splash ;;
    speed)  cmd_speed ;;
    all)    cmd_speed; cmd_theme; cmd_splash; cmd_status ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "Noma'lum buyruq: $1 (bx-boot --help)" >&2; exit 1 ;;
esac

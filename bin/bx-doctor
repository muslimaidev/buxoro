#!/usr/bin/env bash
# bx-doctor — Buxoro tizimini tekshirish: xatolar, xizmatlar, tezlik o'lchovlari
set -uo pipefail
g=$'\e[1;32m' r=$'\e[1;31m' y=$'\e[1;33m' c=$'\e[1;36m' d=$'\e[2m' o=$'\e[0m'
pass=0 fail=0 warnc=0
ok()   { printf '  %s✓%s %s\n' "$g" "$o" "$*"; pass=$((pass + 1)); }
bad()  { printf '  %s✗%s %s\n' "$r" "$o" "$*"; fail=$((fail + 1)); }
meh()  { printf '  %s!%s %s\n' "$y" "$o" "$*"; warnc=$((warnc + 1)); }
head_() { printf '\n%s%s%s\n' "$c" "$*" "$o"; }
ms() { # buyruq bajarilish vaqti (ms), 3 marta o'lchab eng yaxshisi
    local best=999999 t0 t1 dt
    for _ in 1 2 3; do
        t0=$(date +%s%N); "$@" >/dev/null 2>&1; t1=$(date +%s%N)
        dt=$(( (t1 - t0) / 1000000 )); (( dt < best )) && best=$dt
    done
    echo "$best"
}

printf '%s┏┓ ╻ ╻╻ ╻┏━┓┏━┓┏━┓%s\n%s┣┻┓┃ ┃┏╋┛┃ ┃┣┳┛┃ ┃%s  tizim tekshiruvi\n%s┗━┛┗━┛╹ ╹┗━┛╹┗╸┗━┛%s\n' "$c" "$o" "$c" "$o" "$c" "$o"

head_ "Hyprland"
if command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    ver=$(hyprctl version 2>/dev/null | grep -oE 'v?0\.[0-9]+\.[0-9]+' | head -1)
    ok "Versiya: ${ver:-?}"
    errs=$(hyprctl configerrors 2>/dev/null | grep -v '^$' | grep -vi 'no errors')
    [[ -z $errs ]] && ok "Konfiguratsiyada xato yo'q" || bad "Konfiguratsiya xatolari:\n$errs"
    [[ -n ${AQ_DRM_DEVICES:-} ]] && ok "GPU tartibi: $AQ_DRM_DEVICES" || meh "AQ_DRM_DEVICES o'rnatilmagan (bitta GPU bo'lsa — normal)"
else
    meh "Hyprland sessiyasi ichida ishga tushiring"
fi

head_ "Xizmatlar"
for p in waybar swaync swayosd-server hypridle; do
    pgrep -x "$p" >/dev/null && ok "$p ishlayapti" || bad "$p ishlamayapti"
done
if pgrep -x awww-daemon >/dev/null || pgrep -x swww-daemon >/dev/null; then ok "awww (fon rasmi, o'tish effekti: $(bx-wall transition))"; else bad "awww-daemon ishlamayapti"; fi
pgrep -f 'foot --server' >/dev/null && ok "foot server (terminal bir zumda ochiladi)" || meh "foot server ishlamayapti"
pgrep -f hyprpolkitagent >/dev/null && ok "polkit agent (parol oynasi)" || bad "polkit agent ishlamayapti"
pgrep -f 'cliphist store' >/dev/null && ok "Bufer tarixi" || meh "cliphist ishlamayapti"

head_ "Ovoz"
if command -v pactl >/dev/null; then
    srv=$(pactl info 2>/dev/null | sed -n 's/^Server Name: //p')
    case "$srv" in
        *PipeWire*) ok "PipeWire ishlayapti ($srv)" ;;
        "")         bad "Ovoz serveri javob bermayapti → systemctl --user restart pipewire pipewire-pulse wireplumber" ;;
        *)          bad "Eski server: $srv → ./install.sh (PulseAudio'ni PipeWire bilan almashtiradi)" ;;
    esac
fi
pacman -Qq pulseaudio >/dev/null 2>&1 && meh "pulseaudio paketi hali o'rnatilgan (pipewire-pulse bilan to'qnashadi)"

head_ "Tezlik"
if command -v zsh >/dev/null; then
    t=$(ms zsh -i -c exit)
    (( t < 80 )) && ok "zsh ishga tushishi: ${t} ms" || meh "zsh ishga tushishi: ${t} ms (80 ms dan sekin)"
fi
if command -v nvim >/dev/null; then
    f=$(mktemp); nvim --headless --startuptime "$f" +qa >/dev/null 2>&1
    t=$(tail -1 "$f" | awk '{printf "%d", $1}'); rm -f "$f"
    (( t < 120 )) && ok "Neovim ishga tushishi: ${t} ms" || meh "Neovim ishga tushishi: ${t} ms"
fi
if command -v footclient >/dev/null && pgrep -f 'foot --server' >/dev/null; then
    ok "Terminal: footclient (server rejimi)"
fi
if command -v systemd-analyze >/dev/null; then
    boot=$(systemd-analyze 2>/dev/null | head -1 | sed 's/Startup finished in //')
    [[ -n $boot ]] && ok "Yuklanish: $boot" || meh "systemd-analyze ma'lumot bermadi"
    slow=$(systemd-analyze blame 2>/dev/null | head -1)
    [[ -n $slow ]] && printf '    %seng sekin xizmat: %s%s\n' "$d" "$(echo "$slow" | xargs)" "$o"
    systemctl is-enabled NetworkManager-wait-online.service >/dev/null 2>&1 &&
        meh "NetworkManager-wait-online yoqilgan (yuklanishni sekinlashtiradi) → bx-boot speed"
fi

head_ "Yuklanish ko'rinishi"
th=$(plymouth-set-default-theme 2>/dev/null)
[[ $th == buxoro ]] && ok "Plymouth: Buxoro splash" || meh "Plymouth splash o'rnatilmagan → bx-boot splash"
grep -qw splash /proc/cmdline && ok "Jim yuklanish (quiet splash)" || meh "Yadro parametrlarida 'splash' yo'q"
systemctl is-enabled greetd.service >/dev/null 2>&1 && ok "Login ekrani: greetd + ReGreet" || meh "Buxoro login ekrani yoqilmagan → bx-greeter install"

head_ "Grafika"
if lspci -d ::03xx 2>/dev/null | grep -qi nvidia; then
    dgpu=$(lspci -D -d ::03xx | grep -i nvidia | head -1 | cut -d' ' -f1)
    st=$(cat "/sys/bus/pci/devices/$dgpu/power/runtime_status" 2>/dev/null)
    case "$st" in
        suspended) ok "NVIDIA uxlab yotibdi (batareya tejalmoqda)" ;;
        active)    meh "NVIDIA faol — biror dastur ishlatyapti yoki RTD3 o'chiq (nvidia-smi bilan tekshiring)" ;;
        *)         meh "NVIDIA holati noma'lum" ;;
    esac
    [[ -e /dev/dri/bx-igpu ]] && ok "Ish stolini ichki karta chizadi" || meh "/dev/dri/bx-igpu yo'q (install.sh dagi udev qoidasi)"
else
    ok "Bitta videokarta"
fi

head_ "Printer"
if systemctl is-active --quiet cups.socket || systemctl is-active --quiet cups.service; then
    ok "CUPS faol"
    n=$(lpstat -e 2>/dev/null | wc -l)
    (( n > 0 )) && ok "Printerlar: $(lpstat -e | tr '\n' ' ')" || meh "Printer qo'shilmagan → bx-printer add"
    def=$(lpstat -d 2>/dev/null | awk -F': ' '/:/ {print $2}')
    [[ -n $def ]] && ok "Standart: $def"
    for p in $(lpstat -e 2>/dev/null); do
        if grep -qs '^\*cupsManualCopies: True' "/etc/cups/ppd/$p.ppd" 2>/dev/null; then
            ok "$p: nusxalarni CUPS yaratadi (ko'p nusxa ishonchli)"
        fi
    done
else
    bad "CUPS ishlamayapti → sudo systemctl enable --now cups.socket"
fi

head_ "Shriftlar va mavzu"
fc-list | grep -qi 'Inter' && ok "Inter" || bad "Inter shrifti yo'q (inter-font)"
fc-list | grep -qi 'JetBrainsMono Nerd' && ok "JetBrainsMono Nerd Font" || bad "Nerd Font yo'q (ttf-jetbrains-mono-nerd)"
ok "Mavzu: $(bx-theme current 2>/dev/null || echo '?')  ·  ranglar rasmdan: $(cat "${XDG_STATE_HOME:-$HOME/.local/state}/buxoro/auto-colors" 2>/dev/null || echo off)"
command -v rofi >/dev/null && ok "Galereya: rofi" || meh "rofi yo'q — galereya oddiy menyuda ochiladi"
command -v python3 >/dev/null && ok "bx-colors uchun Python" || bad "python yo'q — fon rasmidan ranglar ishlamaydi"

printf '\n  %s%d ✓%s   %s%d !%s   %s%d ✗%s\n\n' "$g" "$pass" "$o" "$y" "$warnc" "$o" "$r" "$fail" "$o"
(( fail == 0 ))

/* AVTOMATIK YARATILGAN FAYL — mavzu: {{name}}. Manba: templates/rofi/buxoro.rasi.tmpl
   Buxoro galereyasi: mavzu va fon rasmlari tanlagichi (bx-picker) */
configuration {
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    bg:      {{bg}}f0;
    bg-alt:  {{bg_alt}};
    surface: {{surface}};
    overlay: {{overlay}};
    fg:      {{fg}};
    sub:     {{subtext}};
    muted:   {{muted}};
    accent:  {{accent}};
    gold:    {{gold}};
    font: "Inter 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 1180px;
    border: 1px;
    border-color: @overlay;
    border-radius: 24px;
    background-color: @bg;
    padding: 22px;
}

mainbox { children: [ inputbar, message, listview ]; spacing: 16px; }

inputbar {
    children: [ prompt, entry ];
    background-color: @surface;
    border: 1px;
    border-color: @overlay;
    border-radius: 14px;
    padding: 12px 16px;
    spacing: 12px;
}
prompt { text-color: @accent; font: "Inter Bold 12"; }
entry  { placeholder: "Qidirish…"; placeholder-color: @muted; cursor: text; }

message { background-color: transparent; }
textbox { text-color: @sub; markup: true; padding: 0 4px; }

listview {
    columns: 4;
    lines: 2;
    spacing: 14px;
    fixed-columns: true;
    fixed-height: true;
    flow: horizontal;
    cycle: true;
    scrollbar: false;
    layout: vertical;
}

element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
    border: 2px;
    border-color: transparent;
    border-radius: 18px;
    background-color: @bg-alt;
    cursor: pointer;
}
element normal.normal, element alternate.normal { background-color: @bg-alt; }
element selected.normal {
    background-color: @surface;
    border-color: @accent;
}
element normal.active, element alternate.active { border-color: @gold; }
element selected.active { background-color: @surface; border-color: @gold; }

element-icon { size: 240px; horizontal-align: 0.5; cursor: inherit; }
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
element selected.normal element-text { text-color: @accent; }

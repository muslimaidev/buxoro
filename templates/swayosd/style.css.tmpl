/* AVTOMATIK YARATILGAN FAYL — mavzu: {{name}} */
window#osd {
  border-radius: 999px;
  border: 1px solid rgba({{overlay.rgb}}, 0.9);
  background: rgba({{bg.rgb}}, 0.9);
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4);
}
window#osd #container { margin: 14px 20px; }
window#osd image { color: {{accent}}; -gtk-icon-size: 22px; }
window#osd label { color: {{fg}}; font-family: "Inter"; font-weight: 700; font-size: 14px; min-width: 40px; }
window#osd progressbar:disabled,
window#osd image:disabled { opacity: 0.45; }
window#osd progressbar,
window#osd segmentedprogress {
  min-height: 8px;
  min-width: 220px;
  border-radius: 999px;
  background: transparent;
  border: none;
}
window#osd trough,
window#osd segment {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background: {{overlay}};
}
window#osd progress,
window#osd segment.active {
  min-height: inherit;
  border-radius: inherit;
  border: none;
  background: linear-gradient(90deg, {{accent}}, {{gold}});
}
window#osd segment { margin-left: 6px; }
window#osd segment:first-child { margin-left: 0; }

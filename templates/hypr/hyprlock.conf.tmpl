# AVTOMATIK YARATILGAN FAYL — manba: templates/hypr/hyprlock.conf.tmpl
general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = smooth, 0.25, 1, 0.5, 1
    animation = fadeIn, 1, 4, smooth
    animation = fadeOut, 1, 4, smooth
    animation = inputFieldDots, 1, 2, smooth
}

background {
    monitor =
    path = screenshot
    color = rgba({{bg.hex}}ff)
    blur_passes = 4
    blur_size = 8
    brightness = 0.6
    vibrancy = 0.2
}

# Soat
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgba({{fg.hex}}ff)
    font_size = 110
    font_family = Inter Display Bold
    position = 0, 160
    halign = center
    valign = center
}

# Sana (o'zbekcha)
label {
    monitor =
    text = cmd[update:60000] LC_TIME=uz_UZ.UTF-8 date +"%A, %-d-%B" 2>/dev/null || date +"%A, %d %B"
    color = rgba({{subtext.hex}}ff)
    font_size = 20
    font_family = Inter
    position = 0, 50
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 320, 56
    outline_thickness = 2
    dots_size = 0.22
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgba({{accent.hex}}ee) rgba({{accent2.hex}}ee) 45deg
    inner_color = rgba({{surface.hex}}cc)
    font_color = rgba({{fg.hex}}ff)
    font_family = Inter
    fade_on_empty = true
    placeholder_text = <span foreground="##{{muted.hex}}">Parol…</span>
    check_color = rgba({{gold.hex}}ff)
    fail_color = rgba({{red.hex}}ff)
    fail_text = <i>Noto‘g‘ri parol ($ATTEMPTS)</i>
    capslock_color = rgba({{orange.hex}}ff)
    rounding = 14
    position = 0, -60
    halign = center
    valign = center
}

# Klaviatura tili
label {
    monitor =
    text = $LAYOUT
    color = rgba({{muted.hex}}ff)
    font_size = 13
    font_family = JetBrainsMono Nerd Font
    position = 0, -115
    halign = center
    valign = center
}

# Foydalanuvchi
label {
    monitor =
    text =   $USER
    color = rgba({{subtext.hex}}ff)
    font_size = 14
    font_family = Inter
    position = 0, 40
    halign = center
    valign = bottom
}
